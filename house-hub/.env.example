# このファイルを .env という名前でコピーし、FIREBASE_PASSWORD を書く。.env は Git に入れない。

# Firestore のプロジェクト ID
FIREBASE_PROJECT_ID=farm-dashboard-95875

# 読み取りに使うアカウント（7インチ画面と同じ表示用アカウント。Firestore のルールで読み取り専用）
FIREBASE_EMAIL=display@farm-dashboard.local
FIREBASE_PASSWORD=

# 新しいデータを取りに行く間隔（秒）
POLL_INTERVAL_SECONDS=300

# 履歴を保存する SQLite のファイル
DB_PATH=~/house-hub/data/hub.db

# 画面と API の待ち受け（0.0.0.0 は校内ネットワークのどこからでも。サーバー自身だけなら 127.0.0.1）
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ログの詳しさ（DEBUG / INFO / WARNING）
LOG_LEVEL=INFO
