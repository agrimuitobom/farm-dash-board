rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 共通の関数
    function isSignedIn() {
      return request.auth != null;
    }

    function isServiceAccount() {
      return request.auth != null &&
            request.auth.token.firebase.sign_in_provider == 'service_account';
    }

    // Pico W などサービスアカウント鍵を持てないセンサー用のアカウント
    // （Firebase Authentication に手動で作成したメール/パスワードのユーザー）
    function isSensor() {
      return request.auth != null &&
            request.auth.token.firebase.sign_in_provider == 'password' &&
            request.auth.token.email == 'sensor@farm-dashboard.local';
    }

    // 常時表示用ディスプレイ（キオスク）のアカウント
    // 画面を触った人がデータを書き換えられないよう、読み取り専用にする
    function isViewer() {
      return request.auth != null &&
            request.auth.token.firebase.sign_in_provider == 'password' &&
            request.auth.token.email == 'display@farm-dashboard.local';
    }

    // センサーが送る1件分の計測データとして正しい形か
    // location は登録済みのハウスIDに限る。土壌水分（soilMoisture, %）は付けても付けなくてもよい
    function isValidSensorReading() {
      let data = request.resource.data;
      return data.keys().hasOnly(['location', 'temperature', 'humidity', 'soilMoisture', 'timestamp']) &&
            data.keys().hasAll(['location', 'temperature', 'humidity', 'timestamp']) &&
            data.location is string &&
            exists(/databases/$(database)/documents/houses/$(data.location)) &&
            data.temperature is number && data.temperature > -40 && data.temperature < 80 &&
            data.humidity is number && data.humidity >= 0 && data.humidity <= 100 &&
            (!('soilMoisture' in data) ||
              (data.soilMoisture is number && data.soilMoisture >= 0 && data.soilMoisture <= 100)) &&
            data.timestamp == request.time;
    }

    // 環境データの書き込みはサービスアカウント（Raspberry Pi）と
    // センサーアカウント（Pico W。新規追加のみ）に限る
    // 読み取りは下記の共通ルールでログインユーザーに許可される
    match /environmental_data/{docId} {
      allow write: if isServiceAccount();
      allow create: if isSensor() && isValidSensorReading();
    }

    // すべてのコレクション: ログイン済みユーザーのみ読み書き可能
    // （environmental_data への一般ユーザーの書き込みは除外）
    // センサーアカウントは機器に保存されるため、環境データの追加以外は一切できない
    // 表示用アカウントは読み取りのみ
    match /{collectionName}/{docId=**} {
      allow read: if isSignedIn() && !isSensor();
      allow write: if isSignedIn() && !isSensor() && !isViewer() && collectionName != 'environmental_data';
    }
  }
}
